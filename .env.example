# Atlas (Neovim) provider values consumed by lua/plugins/atlas.lua.
#
# With the Ansible playbook, secrets stay in 1Password — do not fill tokens
# here. The dotfiles role resolves the op:// refs from
# ansible/group_vars/all/defaults.yml and generates ~/.config/nvim/.env.
#
# Manual fallback (no Ansible): copy to config/nvim/.env and fill real values.

# Bitbucket
BITBUCKET_USER="your_bitbucket_username_or_email"
BITBUCKET_TOKEN="your_bitbucket_app_password"

# Jira
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your_jira_email"
JIRA_TOKEN="your_jira_api_token"

# Misc
OPENROUTER_API_KEY="your_key_here"