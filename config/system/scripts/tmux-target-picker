#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
case "$mode" in
sessions | windows) ;;
*)
	printf 'Usage: %s {sessions|windows}\n' "$(basename "$0")" >&2
	exit 2
	;;
esac

build_rows() {
	local session_id session_name session_group window_id pane_id
	local session_label window_index window_name
	local session_format window_format

	session_format=$'#{session_id}\t#{session_name}\t#{?session_group,#{session_group},-}\t#{window_id}\t#{pane_id}'
	window_format=$'#{window_id}\t#{window_index}\t#{window_name}\t#{pane_id}'

	while IFS=$'\t' read -r session_id session_name session_group window_id pane_id; do
		session_label="$session_name"
		if [ "$session_group" != "-" ]; then
			session_label+=" [$session_group]"
		fi

		if [ "$mode" = "sessions" ]; then
			printf 'session\t%s\t%s\t%s\t%s\n' \
				"$session_id" "$window_id" "$pane_id" "$session_label"
			continue
		fi

		while IFS=$'\t' read -r window_id window_index window_name pane_id; do
			printf 'window\t%s\t%s\t%s\t%s  %s: %s\n' \
				"$session_id" "$window_id" "$pane_id" "$session_label" "$window_index" "$window_name"
		done < <(tmux list-windows -t "$session_id" -F "$window_format")
	done < <(tmux list-sessions -F "$session_format")
}

if ! selection="$(FZF_DEFAULT_OPTS= fzf \
	--delimiter=$'\t' \
	--with-nth=5.. \
	--height=100% \
	--layout=reverse \
	--style=minimal \
	--border=none \
	--info=inline-right \
	--prompt='Search: ' \
	--pointer='›' \
	--marker='' \
	--preview='tmux capture-pane -ep -t {4} 2>/dev/null || true' \
	--preview-window='down,45%,border-top,nowrap' \
	< <(build_rows))"; then
	exit 0
fi

[ -n "$selection" ] || exit 0
IFS=$'\t' read -r type session_id window_id _pane_id _display <<<"$selection"

case "$type" in
session)
	tmux switch-client -t "$session_id"
	;;
window)
	tmux select-window -t "$session_id:$window_id"
	tmux switch-client -t "$session_id"
	;;
*)
	printf 'Unknown tmux target type: %s\n' "$type" >&2
	exit 1
	;;
esac
