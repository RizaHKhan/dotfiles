{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "teide_darker",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "keybinds": {
    "leader": "ctrl+b",
    "messages_page_up": "pageup,ctrl+alt+k",
    "messages_page_down": "pagedown,ctrl+alt+j",
    "messages_copy": [
      "<leader>y",
      "ctrl+shift+c"
    ]
  }
}
